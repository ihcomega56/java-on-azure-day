@@ -0,0 +1,30 @@
+package com.example.ticketreservation.repository;
+
+import com.example.ticketreservation.model.Event;
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.query.Param;
+import org.springframework.stereotype.Repository;
+
+import java.time.LocalDateTime;
+import java.util.List;
+
+@Repository
+public interface EventRepository extends JpaRepository<Event, Long> {
+    
+    // 利用可能な席があるイベントを取得
+    @Query("SELECT e FROM Event e WHERE e.availableSeats > 0 AND e.eventDate > CURRENT_TIMESTAMP ORDER BY e.eventDate")
+    List<Event> findAvailableEvents();
+    
+    // カテゴリで検索
+    @Query("SELECT e FROM Event e WHERE e.category = :category ORDER BY e.eventDate")
+    List<Event> findByCategory(@Param("category") String category);
+    
+    // 指定日以降のイベントを取得
+    @Query("SELECT e FROM Event e WHERE e.eventDate >= :fromDate ORDER BY e.eventDate")
+    List<Event> findEventsFromDate(@Param("fromDate") LocalDateTime fromDate);
+    
+    // カテゴリと日付で検索
+    @Query("SELECT e FROM Event e WHERE e.category = :category AND e.eventDate >= :fromDate ORDER BY e.eventDate")
+    List<Event> findByCategoryAndDateFrom(@Param("category") String category, @Param("fromDate") LocalDateTime fromDate);
+}
